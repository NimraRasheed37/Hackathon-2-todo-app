# ===================================================
# EXAMPLE SECRET FILE - DO NOT COMMIT ACTUAL SECRETS
# ===================================================
# Copy this file to secret.yaml and fill in real values
# secret.yaml is gitignored and should NEVER be committed
# ===================================================
apiVersion: v1
kind: Secret
metadata:
  name: todo-secrets
  labels:
    app.kubernetes.io/name: todo-app
    app.kubernetes.io/component: secrets
type: Opaque
data:
  # Base64 encoded values - use: echo -n 'value' | base64
  DATABASE_URL: <base64-encoded-database-url>
  OPENAI_API_KEY: <base64-encoded-openai-api-key>
  JWT_SECRET: <base64-encoded-jwt-secret>
  BETTER_AUTH_SECRET: <base64-encoded-better-auth-secret>

# Example: To encode a value
# echo -n 'postgresql://user:pass@host:5432/db' | base64
# Result: cG9zdGdyZXNxbDovL3VzZXI6cGFzc0Bob3N0OjU0MzIvZGI=
